                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ContentPrimaryBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ContentPrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF181818" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
