                                    VerticalAlignment="Center">
                                <Ellipse x:Name="ChoiceMark" Width="6" Height="6"
                                         Fill="{StaticResource ContentPrimaryBrush}"
                                         Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource StateHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource StatePressedBrush}" />
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource ContentPrimaryBrush}" />
                                <Setter TargetName="ChoiceMark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource ContentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
