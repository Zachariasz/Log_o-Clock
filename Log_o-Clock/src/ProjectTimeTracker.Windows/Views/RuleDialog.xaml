<Window x:Class="ProjectTimeTracker.Windows.Views.RuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window recognition rule" Width="560" Height="480" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource SurfaceElevatedBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="Window recognition rule" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,7,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="The title phrase is matched without case sensitivity. The optional process narrows the match." />
        <TextBlock Grid.Row="2" Text="Project" FontWeight="SemiBold" />
        <ComboBox x:Name="ProjectCombo" Grid.Row="3" Margin="0,4,0,10"
                  DisplayMemberPath="DisplayName" SelectedValuePath="ProjectId" />
        <TextBlock Grid.Row="4" Text="Window title phrase" FontWeight="SemiBold" />
        <TextBox x:Name="PatternText" Grid.Row="5" Margin="0,4,0,10" />
        <StackPanel Grid.Row="6">
            <TextBlock Text="Process name (optional)" FontWeight="SemiBold" />
            <TextBox x:Name="ProcessText" Margin="0,4,0,0" />
            <Button x:Name="CaptureButton" Content="Capture window + process in 3 seconds"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="CaptureButton_Click" />
            <TextBlock x:Name="CaptureStatusText" Foreground="{StaticResource MutedBrush}"
                       Margin="3,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="7" Foreground="{StaticResource DangerBrush}"
                   Margin="3,5,0,0" VerticalAlignment="Top" />
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save rule" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
    </Grid>
</Window>
