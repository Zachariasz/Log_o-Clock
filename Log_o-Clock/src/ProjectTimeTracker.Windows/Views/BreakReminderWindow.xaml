<Window x:Class="ProjectTimeTracker.Windows.Views.BreakReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="268" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Loaded="BreakReminderWindow_Loaded">
    <Border Style="{StaticResource PopupSurfaceStyle}" Padding="18">
        <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" Background="{StaticResource StateHoverBrush}"
                    CornerRadius="18" Margin="0,0,12,0">
                <Path Data="{StaticResource Icon.Coffee}" Fill="{StaticResource IconPrimaryBrush}"
                      Stroke="{StaticResource IconPrimaryBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="18" Height="18"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BREAK REMINDER" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="MessageText" Text="Take a break!" FontSize="18"
                           FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
