<Window x:Class="ProjectTimeTracker.Windows.Views.SoftwareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation settings" Width="560" Height="790" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SoftwareExcludedToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ContentPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" Margin="12,0,0,0"
                                    Background="{StaticResource StateRestBrush}" BorderBrush="{StaticResource BorderStandardBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2"
                                         Fill="{StaticResource ContentSecondaryBrush}" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ContentPrimaryBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ContentPrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF181818" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Text="Software settings" FontSize="22" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Project scope" FontWeight="SemiBold" />
            <ComboBox x:Name="ProjectCombo" Margin="0,4,0,0"
                      SelectedValuePath="ProjectId"
                      SelectionChanged="ProjectCombo_SelectionChanged"
                      ItemTemplate="{StaticResource TimerProjectOptionTemplate}" />
            <TextBlock x:Name="ScopeHelpText"
                       Text="Choose No project to share tracking, exclusion, and correlated tags across every project."
                       Margin="3,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="ApplicationFieldsGrid" Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LabelEditorPanel">
                <TextBlock Text="Label shown in entries" FontWeight="SemiBold" />
                <TextBox x:Name="LabelText" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="ProcessEditorPanel" Grid.Column="2">
                <TextBlock Text="Process name" FontWeight="SemiBold" />
                <TextBox x:Name="ProcessText" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CaptureCurrentButton" Content="Capture current window"
                        Margin="0,0,8,0" Click="CaptureCurrentButton_Click" />
                <Button x:Name="CaptureProcessButton" Content="Capture in 3 seconds"
                        Click="CaptureProcessButton_Click" />
            </StackPanel>
            <TextBlock x:Name="CaptureStatusText" Grid.Row="2" Grid.ColumnSpan="3"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="3,4,0,0" TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Title phrase for recognition" FontWeight="SemiBold" />
            <TextBox x:Name="TitlePatternText" Margin="0,4,0,0" />
            <TextBlock x:Name="TitlePatternHelpText" Text="Optional. Recognition always combines this phrase with the process above."
                       Margin="3,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Expander x:Name="AutomationRulesAdvancedExpander" Grid.Row="4"
                  Header="Advanced recognition rules" Margin="0,14,0,0" IsExpanded="False">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="Additional phrases for this application (one per line)" FontWeight="SemiBold" />
                <TextBox x:Name="AdditionalTitlePatternsText" Height="70" Margin="0,4,0,0"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="Any-application phrases for this project (one per line)"
                           FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBox x:Name="AnyApplicationTitlePatternsText" Height="70" Margin="0,4,0,0"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="Any-application rules can recognize the project regardless of which process is active."
                           Margin="3,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <StackPanel x:Name="ExclusionPanel" Grid.Row="5" Margin="0,16,0,0">
            <CheckBox x:Name="ExcludedCheck"
                      Style="{StaticResource SoftwareExcludedToggleStyle}"
                      Content="Exclude this software from tracked work"
                      Checked="ExcludedCheck_Changed" Unchecked="ExcludedCheck_Changed" />
            <TextBlock Text="While a timer is running, time spent here will be reviewed like an idle interval and can be subtracted."
                       Margin="3,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="CorrelatedTagsEditorPanel" Grid.Row="6" Margin="0,16,0,8">
            <TextBlock Text="Correlated tags" FontWeight="SemiBold" />
            <TextBlock Text="These choices appear as toggle buttons when this software triggers a project reminder."
                       Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Add New" Margin="3,9,0,4" FontWeight="SemiBold" />
            <TextBox x:Name="NewTagText"
                     ToolTip="Type a tag name and finish it with a comma"
                     AutomationProperties.Name="Add New tag"
                     TextChanged="NewTagText_TextChanged" />
            <TextBlock Text="Type a new tag and finish with a comma. New tags are selected automatically."
                       Margin="3,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="NewTagStatusText" Margin="3,3,0,0" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="CorrelatedTagsListPanel" Grid.Row="7" Height="112"
                Background="{StaticResource SurfaceEditorBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Navigation}" Padding="10">
            <Grid>
                <ListBox x:Name="TagsList"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,7,7" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chip"
                                                Background="{StaticResource StateRestBrush}"
                                                BorderBrush="{StaticResource BorderStandardBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="11,6">
                                            <TextBlock x:Name="ChipText"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource ContentTertiaryBrush}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource StateHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{Binding Color}" />
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding Color}" />
                                                <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="NoTagsText" Text="No tags yet. Type a tag name above and finish with a comma."
                           Foreground="{StaticResource MutedBrush}" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="8" Margin="0,16,0,0">
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button Content="Save changes" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
