<Window x:Class="ProjectTimeTracker.Windows.Views.GoogleSheetsConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Google Sheets" Width="650" Height="650" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Connect this profile to Google Sheets" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,7,0,16" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Create a new shared profile, or join a Log O'clock spreadsheet from another computer. The app opens with local data and synchronizes in the background." />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="CreateNewRadio" Content="Create new" IsChecked="True"
                         Checked="ConnectionMode_Changed" Margin="0,0,24,0" />
            <RadioButton x:Name="UseExistingRadio" Content="Use existing spreadsheet"
                         Checked="ConnectionMode_Changed" />
        </StackPanel>
        <Border x:Name="ExistingSpreadsheetPanel" Grid.Row="3" Margin="0,0,0,16" Padding="12"
                Background="{StaticResource StateHoverBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Navigation}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Spreadsheet URL or ID" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox x:Name="SpreadsheetText" AutomationProperties.Name="Existing Google spreadsheet URL or ID" />
                <TextBlock Margin="2,6,2,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Joining is allowed only when this local profile is empty. Its shared name and data will be adopted after authorization." />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Desktop OAuth client" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Open Google Cloud" Click="OpenGoogleCloud_Click" />
            </Grid>
            <TextBlock Text="Client ID" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
            <TextBox x:Name="ClientIdText" AutomationProperties.Name="Google OAuth client ID" />
            <TextBlock Text="Client secret" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,4" />
            <PasswordBox x:Name="ClientSecretText" AutomationProperties.Name="Google OAuth client secret" />
            <TextBlock Margin="2,13,2,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="OAuth secrets remain in Windows Credential Manager on this computer. Profile data is stored only in the selected spreadsheet." />
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="5" Margin="3,14,3,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="ConnectButton" Content="Connect in browser" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Connect_Click" />
        </StackPanel>
    </Grid>
</Window>
