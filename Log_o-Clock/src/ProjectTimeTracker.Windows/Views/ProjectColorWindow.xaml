<Window x:Class="ProjectTimeTracker.Windows.Views.ProjectColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project color" Width="470" Height="420" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="{StaticResource MutedBrush}"
                   Text="Pick a hue on the wheel, then adjust its brightness." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="26" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Canvas x:Name="WheelSurface" Width="220" Height="220" HorizontalAlignment="Left"
                    Background="Transparent" Cursor="Cross" Focusable="True" FocusVisualStyle="{x:Null}"
                    MouseLeftButtonDown="Wheel_MouseLeftButtonDown"
                    MouseMove="Wheel_MouseMove" MouseLeftButtonUp="Wheel_MouseLeftButtonUp">
                <Image x:Name="WheelImage" Width="220" Height="220" IsHitTestVisible="False" />
                <Ellipse x:Name="WheelSelector" Width="16" Height="16" Stroke="White" StrokeThickness="2"
                         Fill="#44000000" IsHitTestVisible="False" />
            </Canvas>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Light" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <Slider x:Name="BrightnessSlider" Orientation="Vertical" Minimum="0.15" Maximum="1"
                            Value="1" Height="174" Margin="0,5,0,0" ValueChanged="BrightnessSlider_ValueChanged" />
                    <TextBlock Text="Dark" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Preview" FontWeight="SemiBold" />
                    <Border x:Name="PreviewSwatch" Width="100" Height="72" Margin="0,8,0,8"
                            CornerRadius="10" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" />
                    <TextBlock x:Name="HexText" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Apply color" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
