<Window x:Class="ProjectTimeTracker.Windows.Views.ProjectChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose project" Width="420" Height="330" Topmost="True" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Which project are you working on?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,7,0,14" Foreground="{StaticResource MutedBrush}"
                   Text="Several equally specific window rules matched." />
        <ListBox x:Name="ProjectsList" Grid.Row="2" DisplayMemberPath="DisplayName" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Dismiss" Click="Dismiss_Click" />
            <Button Content="Start selected" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>
