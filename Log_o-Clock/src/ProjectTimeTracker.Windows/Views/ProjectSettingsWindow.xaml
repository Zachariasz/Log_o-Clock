<Window x:Class="ProjectTimeTracker.Windows.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project settings" Width="620" Height="820" MinHeight="680"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,7,0,10" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Targets include weekends. Daily periods reset at 06:00; weekly periods reset Monday at 06:00; monthly periods reset on the first day at 06:00." />

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Client" FontWeight="SemiBold" />
            <ComboBox x:Name="ClientCombo" DisplayMemberPath="Name" SelectedValuePath="Id" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Targets" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,12,8" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Double-click a target to edit it. Blank daily, weekly, and monthly rows are previews only and become real targets after hours are set. Right-click empty space to add another target." />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Shared with Targets tab" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Top" Margin="8,2,0,0" />
            </Grid>

            <DataGrid x:Name="ProjectTargetsGrid" Grid.Row="1"
                      MinHeight="180"
                      PreviewMouseRightButtonDown="ProjectTargetsGrid_PreviewMouseRightButtonDown"
                      MouseDoubleClick="ProjectTargetsGrid_MouseDoubleClick"
                      ContextMenuOpening="ProjectTargetsGrid_ContextMenuOpening"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGhost}" Value="True">
                                <Setter Property="Opacity" Value="0.48" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add target..." Click="AddProjectTarget_Click" />
                        <MenuItem x:Name="EditProjectTargetMenuItem" Header="Edit..."
                                  Click="EditProjectTarget_Click" />
                        <Separator x:Name="RemoveProjectTargetSeparator" />
                        <MenuItem x:Name="RemoveProjectTargetMenuItem" Header="Remove"
                                  Click="RemoveProjectTarget_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="*"
                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"
                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                    <DataGridTextColumn Header="Hours" Binding="{Binding TargetTime}" Width="90"
                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                    <DataGridTextColumn Header="Counts" Binding="{Binding DurationMetricText}" Width="145"
                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="CarryOverTargetDebtCheck"
                      Content="Carry unmet monthly target as debt"
                      ToolTip="At each month end, carry any missing monthly hours forward. Only hours above the daily, weekly, or monthly baseline repay that debt." />
            <TextBlock Margin="24,4,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Repayment uses surplus above the combined Daily targets first; if none exist, Weekly targets; otherwise Monthly targets." />
        </StackPanel>

        <Border x:Name="CanceledDebtPanel" Grid.Row="5" Margin="0,10,0,0" Padding="12"
                Background="{StaticResource SurfaceEditorBrush}"
                BorderBrush="{StaticResource BorderStandardBrush}"
                BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Debt reductions and cancellations" FontWeight="SemiBold" />
                    <TextBlock x:Name="CanceledDebtText" Margin="0,3,12,0" FontSize="11"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button x:Name="RestoreCanceledDebtButton" Grid.Column="1"
                        Content="Bring debt back" VerticalAlignment="Center"
                        Click="RestoreCanceledDebt_Click"
                        ToolTip="Restore all canceled debt for this project when settings are saved." />
            </Grid>
        </Border>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Hourly rate" FontWeight="SemiBold" />
                <TextBox x:Name="HourlyRateText"
                         ToolTip="Leave blank if this project is not billed hourly" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Currency" FontWeight="SemiBold" />
                <ComboBox x:Name="CurrencyCombo" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ValidationText" Grid.Row="7" Margin="3,12,3,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Save settings" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
