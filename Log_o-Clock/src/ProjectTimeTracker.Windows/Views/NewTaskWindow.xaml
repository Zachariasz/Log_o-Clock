<Window x:Class="ProjectTimeTracker.Windows.Views.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New task" Width="500" Height="300" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Create a task" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,12" Foreground="{StaticResource MutedBrush}"
                   Text="Choose the project that owns this saved task." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project" FontWeight="SemiBold" />
                <ComboBox x:Name="ProjectCombo" DisplayMemberPath="DisplayName" SelectedValuePath="ProjectId" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Task name" FontWeight="SemiBold" />
                <TextBox x:Name="TaskNameText" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="3,10,3,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Create task" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
