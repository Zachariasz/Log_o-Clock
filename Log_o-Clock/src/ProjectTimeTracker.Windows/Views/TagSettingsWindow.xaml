<Window x:Class="ProjectTimeTracker.Windows.Views.TagSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag settings" Width="500" Height="460" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,16" Foreground="{StaticResource MutedBrush}"
                   Text="Project tags appear only in that project. Global tags are available everywhere."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Tag name" FontWeight="SemiBold" />
            <TextBox x:Name="TagNameText" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Availability" FontWeight="SemiBold" />
            <ComboBox x:Name="ScopeCombo" DisplayMemberPath="DisplayName" SelectedValuePath="ProjectId" />
            <TextBlock Margin="2,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="Choose Global (all projects), or one project for a project-related tag." />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,18,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ColorSwatch" Width="32" Height="32" CornerRadius="8"
                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" />
            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="Tag color" FontWeight="SemiBold" />
                <TextBlock x:Name="ColorHexText" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Choose color…" VerticalAlignment="Center"
                    Click="ChooseColor_Click" />
        </Grid>

        <TextBlock x:Name="ValidationText" Grid.Row="5" Margin="3,10,3,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
