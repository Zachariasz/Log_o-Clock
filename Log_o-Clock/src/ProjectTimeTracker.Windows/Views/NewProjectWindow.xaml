<Window x:Class="ProjectTimeTracker.Windows.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Width="470" Height="370" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Create a project" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,12" Foreground="{StaticResource MutedBrush}"
                   Text="Choose the client that owns this project." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Client" FontWeight="SemiBold" />
                <ComboBox x:Name="ClientCombo" DisplayMemberPath="Name" SelectedValuePath="Id" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Project name" FontWeight="SemiBold" />
                <TextBox x:Name="ProjectNameText" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ColorSwatch" Width="32" Height="32" CornerRadius="8"
                    Background="#FF7356" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" />
            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="Project color" FontWeight="SemiBold" />
                <TextBlock x:Name="ColorHexText" Text="#FF7356" FontFamily="Consolas"
                           FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button x:Name="ChooseColorButton" Grid.Column="2" Content="Choose color…"
                    VerticalAlignment="Center" Click="ChooseColor_Click" />
        </Grid>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="3,10,3,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Create project" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
