<Window x:Class="ProjectTimeTracker.Windows.Views.TargetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target" Width="520" Height="520" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ScopeHelpText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Set an additional target for a project or leave Project as All projects. Project settings still control carry-over target debt." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Name" FontWeight="SemiBold" />
            <TextBox x:Name="NameText" ToolTip="Optional — a clear name is created automatically when blank" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Project" FontWeight="SemiBold" />
            <ComboBox x:Name="ProjectCombo" DisplayMemberPath="DisplayName" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Target type" FontWeight="SemiBold" />
                <ComboBox x:Name="CadenceCombo" DisplayMemberPath="DisplayName" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hours" FontWeight="SemiBold" />
                <TextBox x:Name="HoursText" ToolTip="Must be greater than zero" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Count toward target" FontWeight="SemiBold" />
            <ComboBox x:Name="DurationMetricCombo" DisplayMemberPath="DisplayName" />
            <TextBlock Margin="3,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="Time including short idle adds back only excluded idle intervals that do not exceed the limit configured in Settings." />
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="5" Margin="3,14,3,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save target" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
