<Window x:Class="ProjectTimeTracker.Windows.Views.EntryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ProjectTimeTracker.Windows.Controls"
        Width="470" Height="390" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="EntryDetailsWindow_PreviewKeyDown">
    <Border Style="{StaticResource PopupSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeadingText"
                       Text="What are you working on?"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ProjectText" Grid.Row="1" Margin="0,4,0,14" Foreground="{StaticResource MutedBrush}" />
            <StackPanel x:Name="ProjectChooserPanel" Grid.Row="1" Margin="0,4,0,10" Visibility="Collapsed">
                <TextBlock Text="Project" Margin="3,0,0,4" Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="ProjectCombo"
                          SelectedValuePath="ProjectId"
                          ItemTemplate="{StaticResource TimerProjectOptionTemplate}"
                          ItemContainerStyle="{StaticResource TimerProjectComboItemStyle}"
                          ToolTip="Choose project and client"
                          AutomationProperties.Name="Project and client"
                          SelectionChanged="ProjectCombo_SelectionChanged"
                          DropDownOpened="ProjectCombo_DropDownOpened"
                          DropDownClosed="ProjectCombo_DropDownClosed" />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <TextBlock Text="Task" Margin="3,0,0,4" Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="TaskCombo"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          ToolTip="Select a saved task or type a new task name"
                          AutomationProperties.Name="Task"
                          SelectionChanged="TaskCombo_SelectionChanged"
                          DropDownOpened="TaskCombo_DropDownOpened"
                          DropDownClosed="TaskCombo_DropDownClosed" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Description (optional)" Margin="3,8,0,0" Foreground="{StaticResource MutedBrush}" />
            <controls:TagDescriptionEditor x:Name="DescriptionText" Grid.Row="4" AcceptsReturn="True" Style="{StaticResource TagEditorStyle}" />
            <TextBlock x:Name="SaveStatusText" Grid.Row="5"
                       Text="Changes save automatically · click away when finished"
                       Margin="3,8,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11" />
            <Grid x:Name="RunningFooter" Grid.Row="6" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="StartTimePanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed">
                    <TextBlock Text="Started"
                               Margin="3,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                    <TextBox x:Name="StartTimeText"
                             Width="76"
                             Margin="0"
                             VerticalContentAlignment="Center"
                             ToolTip="Edit the timer start time. A time later than now is treated as yesterday."
                             AutomationProperties.Name="Timer start time"
                             TextChanged="StartTimeText_TextChanged"
                             LostKeyboardFocus="StartTimeText_LostKeyboardFocus" />
                </StackPanel>
                <StackPanel x:Name="RunningActionsPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <Button x:Name="RipButton" Content="Rip from this moment" Visibility="Collapsed"
                            ToolTip="Finish this entry now and begin a new one with the same task and description"
                            Click="RipButton_Click" />
                    <Button x:Name="StopTimerButton" Content="Stop timer" Visibility="Collapsed"
                            Style="{StaticResource RunningTimerButton}"
                            ToolTip="Save these details and stop the running timer"
                            Click="StopTimerButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
