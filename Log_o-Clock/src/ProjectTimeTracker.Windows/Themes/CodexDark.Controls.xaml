<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ContentPrimaryBrush}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PageDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ContentTertiaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ContentPrimaryBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
