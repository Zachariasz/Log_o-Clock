<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ChromeIconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource IconPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.33" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="10.67" />
        <Setter Property="Height" Value="10.67" />
    </Style>
    <Style x:Key="FloatingNavigationSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfacePopupBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHeavyBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Menu}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.34" Color="#FF000000" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
