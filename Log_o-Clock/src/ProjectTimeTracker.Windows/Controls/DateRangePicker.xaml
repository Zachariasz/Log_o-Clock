<UserControl x:Class="ProjectTimeTracker.Windows.Controls.DateRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinHeight="32" Focusable="False">
    <Grid>
        <TextBox x:Name="RangeTextBox" Margin="0" MinHeight="32" Padding="10,4,38,4"
                 VerticalContentAlignment="Center"
                 TextChanged="RangeTextBox_TextChanged"
                 PreviewKeyDown="RangeTextBox_PreviewKeyDown"
                 LostKeyboardFocus="RangeTextBox_LostKeyboardFocus"
                 AutomationProperties.Name="Date range"
                 AutomationProperties.HelpText="Enter a date range as DD.MM.YYYY - DD.MM.YYYY, or choose one day and optionally a second day" />

        <Button x:Name="CalendarButton" Width="32" Height="30" MinHeight="0" Padding="6" Margin="0,1,1,1"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource IconButton}" Click="CalendarButton_Click"
                ToolTip="Choose date range" AutomationProperties.Name="Choose date range">
            <Path Data="{StaticResource Icon.Calendar}" Style="{StaticResource ChromeIconPathStyle}"
                  Width="18" Height="18" />
        </Button>

        <Popup x:Name="RangePopup" PlacementTarget="{Binding ElementName=RangeTextBox}"
               Placement="Bottom" VerticalOffset="5" StaysOpen="False" AllowsTransparency="True"
               Opened="RangePopup_Opened" Closed="RangePopup_Closed">
            <Border Background="Transparent" CornerRadius="{StaticResource Radius.Menu}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.32" Color="#FF000000" />
                </Border.Effect>
                <Calendar x:Name="RangeCalendar" SelectionMode="SingleRange"
                          Style="{StaticResource DarkCalendarStyle}"
                          SelectedDatesChanged="RangeCalendar_SelectedDatesChanged"
                          AutomationProperties.Name="Choose one day or a start and end date" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
