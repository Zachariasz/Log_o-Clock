                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Color}"
                                                                        Margin="0,3,7,0" VerticalAlignment="Top" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Client}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding LegendDetail}" Foreground="{StaticResource MutedBrush}"
