                                            <TextBlock Text="Client share" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ReportClientChartRangeText" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" Margin="0,3,0,5" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="160" Height="160" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Image x:Name="ReportClientDonutImage" Width="160" Height="160" Stretch="None" />
