<Window x:Class="ProjectTimeTracker.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ProjectTimeTracker.Windows"
        xmlns:controls="clr-namespace:ProjectTimeTracker.Windows.Controls"
        xmlns:converters="clr-namespace:ProjectTimeTracker.Windows.Converters"
        xmlns:services="clr-namespace:ProjectTimeTracker.Windows.Services"
        Title="Log O'clock" Width="1180" Height="800" MinWidth="800" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource SurfaceAppBrush}"
        StateChanged="MainWindow_StateChanged" SizeChanged="MainWindow_SizeChanged"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        services:WindowBackdropService.Role="MainShell">
    <Window.Resources>
        <converters:HistoryGroupDurationConverter x:Key="HistoryGroupDurationConverter" />
        <converters:WrapOpportunityConverter x:Key="WrapOpportunityConverter" />
        <Style x:Key="DateRangeShortcutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="local:MainWindow.DateRangeShortcutActive" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileSelectorButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ContentTertiaryBrush}" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="AutomaticModeTitleBarToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="36" Height="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource StatePressedBrush}"
                                    BorderBrush="{StaticResource BorderHeavyBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2"
                                         Fill="{StaticResource ContentSecondaryBrush}"
                                         HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF181818" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SidebarTargetRowTemplate">
            <Grid Margin="4,5,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.ColumnSpan="2" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Client}" MaxWidth="82"
                               Foreground="{StaticResource ProjectClientTextBrush}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Ellipse DockPanel.Dock="Right" Width="5" Height="5" Margin="8,1,8,0"
                             Fill="{StaticResource ProjectClientDotBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource InkBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Border x:Name="DailyTargetLine" Grid.Row="1" Margin="0,3,0,0"
                        Padding="3,1" CornerRadius="3" Background="Transparent">
                    <DockPanel>
                        <TextBlock x:Name="DailyTargetMarker" Text="D" Width="18"
                                   Foreground="{StaticResource TargetDailyBrush}"
                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="DailyTargetValue" Text="{Binding Daily}"
                                   Foreground="{StaticResource ContentSecondaryBrush}"
                                   FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <DockPanel x:Name="WeeklyTargetLine" Grid.Row="2" Margin="0,2,0,0">
                    <TextBlock x:Name="WeeklyTargetMarker" Text="W" Width="18" Foreground="{StaticResource TargetWeeklyBrush}"
                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Weekly}" Foreground="{StaticResource ContentSecondaryBrush}"
                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DockPanel x:Name="MonthlyTargetLine" Grid.Row="3" Margin="0,2,0,0">
                    <TextBlock x:Name="MonthlyTargetMarker" Text="M" Width="18" Foreground="{StaticResource TargetMonthlyBrush}"
                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Monthly}" Foreground="{StaticResource ContentSecondaryBrush}"
                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DockPanel x:Name="OneTimeTargetLine" Grid.Row="4" Margin="0,2,0,0">
                    <TextBlock Text="1×" Width="18" Foreground="{StaticResource ContentTertiaryBrush}"
                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OneTime}" Foreground="{StaticResource ContentSecondaryBrush}"
                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <controls:TargetProgressRing x:Name="SidebarTargetProgressRing"
                                             Grid.Column="1" Grid.Row="1" Grid.RowSpan="4"
                                             Width="40" Height="40" Margin="8,3,2,0"
                                             VerticalAlignment="Center"
                                             DailyProgress="{Binding DailyProgress}"
                                             WeeklyProgress="{Binding WeeklyProgress}"
                                             MonthlyProgress="{Binding MonthlyProgress}"
                                             DailyBrush="{StaticResource TargetDailyBrush}"
                                             WeeklyBrush="{StaticResource TargetWeeklyBrush}"
                                             MonthlyBrush="{StaticResource TargetMonthlyBrush}"
                                             TrackBrush="{StaticResource BorderStandardBrush}"
                                             StrokeThickness="4"
                                             ToolTip="Daily, weekly, and monthly target progress"
                                             AutomationProperties.Name="Daily, weekly, and monthly target progress">
                    <controls:TargetProgressRing.Style>
                        <Style TargetType="controls:TargetProgressRing">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                             Value="SidebarTargetRing">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOneTimeTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:TargetProgressRing.Style>
                </controls:TargetProgressRing>

                <TextBlock x:Name="DebtTargetLine" Grid.Row="5" Grid.ColumnSpan="2" Margin="18,3,0,0"
                           Text="{Binding Debt}" Foreground="{StaticResource WarningBrush}"
                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CanceledDebtTargetLine" Grid.Row="6" Grid.ColumnSpan="2" Margin="18,3,0,0"
                           Text="{Binding CanceledDebt}" Foreground="{StaticResource ContentTertiaryBrush}"
                           FontSize="10" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DailyTargetHours}" Value="{x:Null}">
                    <Setter TargetName="DailyTargetLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDailyReached}" Value="True">
                    <Setter TargetName="DailyTargetLine" Property="Background" Value="{StaticResource DailyTargetCompleteBrush}" />
                    <Setter TargetName="DailyTargetValue" Property="Foreground" Value="{StaticResource ContentPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WeeklyTargetHours}" Value="{x:Null}">
                    <Setter TargetName="WeeklyTargetLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MonthlyTargetHours}" Value="{x:Null}">
                    <Setter TargetName="MonthlyTargetLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OneTimeTargetHours}" Value="{x:Null}">
                    <Setter TargetName="OneTimeTargetLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDebt}" Value="False">
                    <Setter TargetName="DebtTargetLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCanceledDebt}" Value="False">
                    <Setter TargetName="CanceledDebtTargetLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SidebarTargetItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TargetRowSurface"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TargetRowSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTargetsListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarTargetItemStyle}" />
        </Style>

        <Style x:Key="SidebarTargetsResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="ResizeIndicator"
                                    Width="36" Height="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="1"
                                    Background="{StaticResource BorderStandardBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResizeIndicator"
                                        Property="Background"
                                        Value="{StaticResource ContentSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ResizeIndicator"
                                        Property="Background"
                                        Value="{StaticResource ContentPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportTargetItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TargetRowSurface"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TargetRowSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportTargetsListStyle" TargetType="ListBox" BasedOn="{StaticResource SidebarTargetsListStyle}">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReportTargetItemStyle}" />
        </Style>
        <Style x:Key="TargetReviewChoiceStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{StaticResource ContentSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ChoiceBorder" Background="{StaticResource StateRestBrush}"
                                    BorderBrush="{StaticResource BorderStandardBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource StateHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource StatePressedBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource ContentSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ContentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowShell" Background="{StaticResource SurfaceAppBrush}" BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource SurfaceAppBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleSidebarColumn" Width="275" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceSidebarBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,1" Padding="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="Transparent" Margin="0,0,10,0">
                        <Image Source="/Assets/AppIcon.png" Width="24" Height="24" Stretch="Uniform"
                               AutomationProperties.Name="Log O'clock icon" />
                    </Border>
                    <TextBlock Text="Time Tracker" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="ProfileButton"
                            Style="{StaticResource ProfileSelectorButtonStyle}"
                            Click="ProfileButton_Click"
                            ToolTip="Switch or manage local profiles"
                            AutomationProperties.Name="Switch or manage local profiles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProfileNameText"
                                       MaxWidth="70"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Path Data="{StaticResource Icon.ChevronDown}"
                                  Stroke="{StaticResource ContentTertiaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="11" Height="11"
                                  Margin="5,0,0,0"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="AutomaticRecognitionToggle"
                              Style="{StaticResource AutomaticModeTitleBarToggleStyle}"
                              Checked="AutomaticRecognitionToggle_Changed"
                              Unchecked="AutomaticRecognitionToggle_Changed"
                              AutomationProperties.Name="Full automatic project tracking" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NavigationToggleButton" Style="{StaticResource IconButton}" Visibility="Collapsed"
                        Margin="8,0,4,0" Click="NavigationToggleButton_Click" ToolTip="Open navigation"
                        AutomationProperties.Name="Open navigation">
                    <Path Data="{StaticResource Icon.Menu}" Style="{StaticResource ChromeIconPathStyle}" Width="18" Height="18" />
                </Button>
                <TextBlock Grid.Column="1" Text="Log O'clock" Foreground="{StaticResource ContentSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <Path Data="{StaticResource Icon.Minimize}" Style="{StaticResource ChromeIconPathStyle}" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click" ToolTip="Maximize or restore"
                            AutomationProperties.Name="Maximize or restore">
                        <Path Data="{StaticResource Icon.Maximize}" Style="{StaticResource ChromeIconPathStyle}" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource TitleBarButton}" Click="CloseWindow_Click" ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource ChromeIconPathStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Popup x:Name="NavigationPopup" Grid.Row="0" PlacementTarget="{Binding ElementName=NavigationToggleButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="228" Margin="0,6,0,0" Style="{StaticResource FloatingNavigationSurfaceStyle}">
                <StackPanel>
                    <Button Content="History" Tag="0" HorizontalContentAlignment="Left" Click="FloatingNavigation_Click" />
                    <Button Content="Clients &amp; Projects" Tag="1" HorizontalContentAlignment="Left" Click="FloatingNavigation_Click" />
                    <Button Content="Reports" Tag="2" HorizontalContentAlignment="Left" Click="FloatingNavigation_Click" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FloatingSettingsNavigationButton" Content="Settings" Tag="3"
                                HorizontalContentAlignment="Left" Click="FloatingNavigation_Click" />
                        <Button x:Name="FloatingUpdateBellButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                Margin="0,0,4,0" Visibility="Collapsed" Click="UpdateBell_Click"
                                ToolTip="A new version of Log O'clock is available. Open Settings to learn more."
                                ToolTipService.InitialShowDelay="1000"
                                AutomationProperties.Name="Open available update details">
                            <Path Data="{StaticResource Icon.Bell}" Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <Separator Margin="4,8" />
                    <TextBlock Text="TARGETS" Margin="8,0,8,4" Foreground="{StaticResource ContentTertiaryBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <ListBox x:Name="FloatingTargetsGrid" MaxHeight="240" Tag="SidebarTargetRing"
                             Style="{StaticResource SidebarTargetsListStyle}"
                             ItemTemplate="{StaticResource SidebarTargetRowTemplate}"
                             PreviewMouseRightButtonDown="SelectTargetOnRightClick"
                             MouseDoubleClick="TargetsList_MouseDoubleClick"
                             ContextMenuOpening="RequireTargetSelection_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit target..." Click="EditTargetProject_Click" />
                                <MenuItem Header="Lower debt..." Click="LowerTargetDebt_Click" />
                                <MenuItem Header="Cancel debt" Click="CancelTargetDebt_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Text="No targets set" Margin="8,3,8,6" Foreground="{StaticResource ContentTertiaryBrush}"
                               FontSize="11" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=FloatingTargetsGrid, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1" Background="{StaticResource SurfaceAppBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TimerSidebarColumn" Width="275" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceSidebarBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,0" />
            <Border Grid.Column="1" MaxWidth="896" HorizontalAlignment="Center" Background="{StaticResource SurfaceEditorBrush}"
                    BorderBrush="{StaticResource BorderStandardBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Composer}" Padding="10" Margin="20,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.26" Color="#FF000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TimerTaskColumn" Width="220" />
                        <ColumnDefinition x:Name="TimerProjectColumn" Width="270" />
                        <ColumnDefinition x:Name="TimerDescriptionColumn" Width="*" />
                        <ColumnDefinition x:Name="TimerElapsedColumn" Width="104" />
                        <ColumnDefinition x:Name="TimerActionColumn" Width="104" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TimerTaskCombo" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id"
                               IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                               SelectionChanged="TimerTaskCombo_SelectionChanged"
                               PreviewKeyDown="TimerBarEditor_PreviewKeyDown"
                               ToolTip="Select a task or type a new task name" AutomationProperties.Name="Task" />
                    <ComboBox x:Name="TimerProjectCombo" Grid.Column="1" SelectedValuePath="ProjectId"
                              ItemTemplate="{StaticResource TimerProjectOptionTemplate}"
                              ItemContainerStyle="{StaticResource TimerProjectComboItemStyle}"
                              SelectionChanged="TimerProjectCombo_SelectionChanged"
                              PreviewKeyDown="TimerBarEditor_PreviewKeyDown" ToolTip="Project and client"
                              AutomationProperties.Name="Project and client" />
                    <controls:TagDescriptionEditor x:Name="TimerDescriptionText" Grid.Column="2" AcceptsReturn="False"
                                                   Style="{StaticResource TagEditorStyle}" VerticalContentAlignment="Center"
                                                   PreviewKeyDown="TimerBarEditor_PreviewKeyDown"
                                                   ToolTip="Description" AutomationProperties.Name="Description" />
                    <TextBlock x:Name="ElapsedText" Grid.Column="3" Text="00:00:00" FontFamily="Consolas" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Button x:Name="StartStopButton" Grid.Column="4" Content="Start" Style="{StaticResource PrimaryButton}"
                            Click="StartStopButton_Click" />
                    <CheckBox x:Name="TimerCallCheck"
                              Grid.Row="1"
                              Grid.Column="3"
                              Margin="4,7,0,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="Call"
                              ToolTip="Track the current timer segment as a call"
                              AutomationProperties.Name="Track current timer segment as a call"
                              Visibility="Collapsed"
                              Checked="TimerCallCheck_Changed"
                              Unchecked="TimerCallCheck_Changed" />
                    <StackPanel x:Name="TimerStartTimePanel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="3,7,0,0"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                        <TextBlock Text="Started"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentTertiaryBrush}"
                                   FontSize="11" />
                        <TextBox x:Name="TimerStartTimeText"
                                 Width="76"
                                 Margin="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Edit the timer start time. A time later than now is treated as yesterday."
                                 AutomationProperties.Name="Timer start time"
                                 TextChanged="TimerStartTimeText_TextChanged"
                                 LostKeyboardFocus="TimerStartTimeText_LostKeyboardFocus"
                                 PreviewKeyDown="TimerBarEditor_PreviewKeyDown" />
                    </StackPanel>
                    <TextBlock x:Name="RemoteTimerStatusText"
                               Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Margin="6,8,6,0" VerticalAlignment="Center"
                               Foreground="{StaticResource ContentTertiaryBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" x:Name="MainTabs" TabStripPlacement="Left" Background="Transparent"
                    Style="{StaticResource SideTabControlStyle}" ItemContainerStyle="{StaticResource SideTabItemStyle}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="History">
                <Grid Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="History" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="Review, edit, and reconcile tracked entries" Style="{StaticResource PageDescriptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="HistorySaveViewButton"
                                    Content="Save Current View"
                                    Visibility="Collapsed"
                                    Click="HistorySaveView_Click" />
                            <Button x:Name="HistoryClearSortingButton"
                                    Content="Clear sorting"
                                    Visibility="Collapsed"
                                    Margin="8,0,0,0"
                                    Click="HistoryClearSorting_Click"
                                    ToolTip="Clear column sorting and restore day groups" />
                            <Button x:Name="HistoryColumnsButton"
                                    Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0"
                                    Click="HistoryColumns_Click"
                                    ToolTip="History view settings"
                                    AutomationProperties.Name="History view settings">
                                <Path Data="{StaticResource Icon.Menu}"
                                      Style="{StaticResource ChromeIconPathStyle}" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="HistoryWrapTextMenuItem"
                                                  Header="Wrap text"
                                                  IsCheckable="True"
                                                  StaysOpenOnClick="True"
                                                  Click="HistoryWrapTextMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Columns" Tag="HistoryColumnsSubmenu" />
                                        <Separator />
                                        <MenuItem Header="Restore default" Click="HistoryRestoreDefaultView_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Refresh" Click="RefreshHistory_Click" />
                        </StackPanel>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Text="Date" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <controls:DateRangePicker x:Name="HistoryRangePicker" Width="235" FontSize="11"
                                                          RangeChanged="HistoryDateRangeChanged" />
                            </StackPanel>
                            <Button x:Name="HistoryThisMonthButton"
                                    Content="This month"
                                    Tag="ThisMonth"
                                    Style="{StaticResource DateRangeShortcutButtonStyle}"
                                    Margin="0,0,4,4"
                                    Click="HistoryDateRangeShortcut_Click" />
                            <Button x:Name="HistoryThisWeekButton"
                                    Content="This week"
                                    Tag="ThisWeek"
                                    Style="{StaticResource DateRangeShortcutButtonStyle}"
                                    Margin="0,0,4,4"
                                    Click="HistoryDateRangeShortcut_Click" />
                            <Button x:Name="HistoryTodayButton"
                                    Content="Today"
                                    Tag="Today"
                                    Style="{StaticResource DateRangeShortcutButtonStyle}"
                                    Margin="0,0,8,4"
                                    Click="HistoryDateRangeShortcut_Click" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <ComboBox x:Name="HistoryProjectCombo" Width="190" DisplayMemberPath="DisplayName"
                                          SelectionChanged="HistoryProjectChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Text="Task" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <ComboBox x:Name="HistoryTaskCombo" Width="140" DisplayMemberPath="DisplayName"
                                          SelectionChanged="HistoryFilterChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Text="Tag" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <ComboBox x:Name="HistoryTagCombo" Width="96" SelectionChanged="HistoryTagChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{Binding Color}" FontWeight="Bold" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Text="Description" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="HistoryDescriptionFilterText"
                                         Width="180"
                                         TextChanged="HistoryDescriptionFilterText_TextChanged"
                                         ToolTip="Filter descriptions by text"
                                         AutomationProperties.Name="Filter History by description" />
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="2" MouseDoubleClick="HistoryGrid_MouseDoubleClick"
                              SelectionMode="Extended" SelectionUnit="FullRow" PreviewMouseRightButtonDown="SelectRowOnRightClick"
                              ContextMenuOpening="HistoryGrid_ContextMenuOpening" RowHeight="42" MinRowHeight="42"
                              local:MainWindow.HistoryTextWrapping="False">
                        <DataGrid.Resources>
                            <Style x:Key="HistoryPassiveSelectionRowStyle"
                                   TargetType="{x:Type DataGridRow}"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="HistoryPassiveSelectionCellStyle"
                                   TargetType="{x:Type DataGridCell}"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="HistoryWrapAwareCellTextStyle"
                                   TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource DataGridCellTextStyle}">
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=(local:MainWindow.HistoryTextWrapping)}">
                                        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                        <Setter Property="TextTrimming" Value="None" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <ContextMenu x:Key="HistoryColumnHeaderMenu" x:Shared="False"
                                         DataContext="{Binding PlacementTarget.Column, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Hide column" Click="HistoryHideColumn_Click" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <StaticResource ResourceKey="HistoryPassiveSelectionRowStyle" />
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <StaticResource ResourceKey="HistoryPassiveSelectionCellStyle" />
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ContextMenu" Value="{StaticResource HistoryColumnHeaderMenu}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Continue" Tag="EntryOnly" Click="ContinueEntry_Click" />
                                <MenuItem Header="Add entry…" Tag="EmptyOnly" Click="AddEntry_Click" />
                                <MenuItem Header="Edit…" Tag="EntryOnly" Click="EditEntry_Click" />
                                <Separator Tag="EntryOnly" />
                                <MenuItem Header="Mark selected as paid" Tag="EntryOnly" Click="MarkSelectedPaid_Click" />
                                <MenuItem Header="Mark selected as unpaid" Tag="EntryOnly" Click="MarkSelectedUnpaid_Click" />
                                <Separator Tag="EntryOnly" />
                                <MenuItem Header="Delete" Tag="EntryOnly" Click="DeleteEntry_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <StackPanel>
                                                        <Border Background="{StaticResource SurfaceEditorBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                                                BorderThickness="0,1,0,1" Padding="0,6" Margin="0,8,0,0">
                                                            <Grid MinWidth="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=ActualWidth}">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Margin="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=Tag.DateMargin}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Converter={StaticResource HistoryGroupDurationConverter}}"
                                                                           Tag="HistoryDayDurationTotal"
                                                                           Margin="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=Tag.DurationMargin}"
                                                                           Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=Tag.Visibility}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="HistoryClientColumn" Header="Client" SortMemberPath="Client" Binding="{Binding Client, Converter={StaticResource WrapOpportunityConverter}}" Width="95" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                            <DataGridTextColumn x:Name="HistoryProjectColumn" Header="Project" SortMemberPath="Project" Binding="{Binding Project, Converter={StaticResource WrapOpportunityConverter}}" Width="115" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                            <DataGridTemplateColumn x:Name="HistoryTaskColumn" Header="Task" SortMemberPath="Task" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Task, Converter={StaticResource WrapOpportunityConverter}}"
                                                   Style="{StaticResource HistoryWrapAwareCellTextStyle}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="HistoryDescriptionColumn" Header="Description" SortMemberPath="Description" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:TagDescriptionDisplay SourceText="{Binding DescriptionSource}"
                                                                        TagDefinitions="{Binding TagDefinitions}"
                                                                        Style="{StaticResource HistoryWrapAwareCellTextStyle}"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="HistoryTagsColumn" Header="Tags" SortMemberPath="Tags" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:TagDescriptionDisplay SourceText="{Binding TagsSource}"
                                                                        TagDefinitions="{Binding TagDefinitions}"
                                                                        Style="{StaticResource HistoryWrapAwareCellTextStyle}"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="HistorySoftwareColumn" Header="Software" SortMemberPath="Software" Binding="{Binding Software, Converter={StaticResource WrapOpportunityConverter}}" Width="120" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                            <DataGridTextColumn x:Name="HistoryStartColumn" Header="Start" SortMemberPath="StartUtc" Binding="{Binding Start}" Width="72" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                            <DataGridTextColumn x:Name="HistoryEndColumn" Header="End" SortMemberPath="EndUtc" Binding="{Binding End}" Width="72" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                            <DataGridTemplateColumn x:Name="HistoryDurationColumn" Header="Duration" SortMemberPath="NetDurationSeconds" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.TimeOverlap}"
                                                      Stroke="{StaticResource DangerBrush}"
                                                      StrokeThickness="1.75"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      SnapsToDevicePixels="True"
                                                      Width="10"
                                                      Height="10"
                                                      Margin="0,0,4,0"
                                                      ToolTip="This entry overlaps another tracked time interval">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTimeOverlap}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding Duration}" FontFamily="Consolas" FontSize="12"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExcludedDuration}" FontFamily="Consolas"
                                                       FontSize="8" Foreground="{StaticResource ContentTertiaryBrush}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasExcludedTime}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="HistoryPaymentColumn" Header="Payment" SortMemberPath="Payment" Binding="{Binding Payment}" Width="72" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                            <DataGridTextColumn x:Name="HistoryStatusColumn" Header="Status" SortMemberPath="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource HistoryWrapAwareCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Clients &amp; projects">
                <Grid Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Clients &amp; Projects" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Organize clients, projects, tasks, tags, software labels, and recognition rules" Style="{StaticResource PageDescriptionTextStyle}" />
                    </StackPanel>
                <TabControl x:Name="ManagementTabs" Grid.Row="1"
                            SelectionChanged="ManagementTabs_SelectionChanged">
                    <TabItem Header="Clients">
                        <Grid Margin="14">
                            <ListBox x:Name="ClientsGrid" PreviewMouseRightButtonDown="SelectListItemOnRightClick"
                                     MouseDoubleClick="ClientsGrid_MouseDoubleClick"
                                     ContextMenuOpening="ClientsGrid_ContextMenuOpening"
                                     Background="Transparent" BorderBrush="Transparent"
                                     BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add client…" Tag="EmptyOnly" Click="AddClient_Click" />
                                        <MenuItem Header="Rename…" Tag="ClientOnly" Click="RenameClient_Click" />
                                        <Separator Tag="ClientOnly" />
                                        <MenuItem Header="Remove" Tag="ClientOnly" Click="ArchiveClient_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch"
                                                  Foreground="{StaticResource InkBrush}">
                                            <Expander.Template>
                                                <ControlTemplate TargetType="Expander">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="36" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ToggleButton x:Name="HeaderToggle" Grid.Row="0" Focusable="False"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="15,0">
                                                                        <Path x:Name="Chevron" Data="M 1 0 L 6 5 L 1 10"
                                                                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"
                                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                              Width="7" Height="11" HorizontalAlignment="Left"
                                                                              VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Chevron" Property="Data" Value="M 0 1 L 5 6 L 10 1" />
                                                                            <Setter TargetName="Chevron" Property="Width" Value="11" />
                                                                            <Setter TargetName="Chevron" Property="Height" Value="7" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource InkBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Row="0" ContentSource="Header" Margin="38,0,12,0"
                                                                          VerticalAlignment="Center" IsHitTestVisible="False" />
                                                        <ContentPresenter x:Name="ExpandedContent" Grid.Row="1" ContentSource="Content"
                                                                          Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Expander.Template>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}"
                                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                    <Border Background="{StaticResource StateRestBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                                            BorderThickness="1" CornerRadius="7" Padding="8,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding ProjectCount}" Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                            </Expander.Header>
                                            <Border Background="{StaticResource SurfaceEditorBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Navigation}" Margin="32,0,12,10" Padding="10,7">
                                                <Grid>
                                                    <ItemsControl ItemsSource="{Binding Projects}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="3,5" Background="Transparent"
                                                                      MouseLeftButtonDown="ClientProject_MouseLeftButtonDown">
                                                                    <Grid.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Edit project…" Click="EditClientProject_Click" />
                                                                            <MenuItem Header="Rename…" Click="RenameClientProject_Click" />
                                                                            <MenuItem Header="Change color…" Click="ChangeClientProjectColor_Click" />
                                                                            <Separator />
                                                                            <MenuItem Header="Remove" Click="ArchiveClientProject_Click" />
                                                                        </ContextMenu>
                                                                    </Grid.ContextMenu>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color}"
                                                                            Margin="1,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource InkBrush}"
                                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="No active projects" Foreground="{StaticResource MutedBrush}"
                                                               FontStyle="Italic" Margin="3,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Projects">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="ProjectsGrid" Grid.Row="0" PreviewMouseRightButtonDown="SelectRowOnRightClick"
                                      MouseDoubleClick="ProjectsGrid_MouseDoubleClick"
                                      ContextMenuOpening="ProjectsGrid_ContextMenuOpening"
                                      SelectionMode="Extended">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add project…" Tag="EmptyOnly" Click="AddProject_Click" />
                                        <MenuItem Header="Edit…" Tag="ProjectOnly" Click="ProjectSettings_Click" />
                                        <MenuItem Header="Rename…" Tag="ProjectOnly" Click="RenameProject_Click" />
                                        <MenuItem Header="Change color…" Tag="ProjectOnly" Click="ChangeProjectColor_Click" />
                                        <MenuItem Header="Freeze project" Tag="ProjectOnly" Click="FreezeProject_Click" />
                                        <MenuItem Header="Unfreeze project" Tag="ProjectOnly" Click="UnfreezeProject_Click" />
                                        <Separator Tag="ProjectOnly" />
                                        <MenuItem Header="Remove" Tag="ProjectOnly" Click="ArchiveProject_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Project" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color}"
                                                            Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Color}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
