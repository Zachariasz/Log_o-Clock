                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Project share · time including short idle"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReportInclusiveChartRangeText"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Margin="0,3,0,5" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="140" Height="140" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Image x:Name="ReportInclusiveDonutImage" Width="140" Height="140" Stretch="Uniform" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="ReportInclusiveDonutTotalHours" Text="0:00 h"
                                                       FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="time + idle" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto" Margin="5,0,0,0">
                                        <ItemsControl x:Name="ReportInclusiveLegendItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Color}"
                                                                Margin="0,3,7,0" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Project}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding TotalWithShortIdle}" Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border x:Name="ReportTargetsCard" Margin="0,12,0,0" MinHeight="220"
                                Background="{StaticResource SurfaceEditorBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Monthly targets" FontSize="13" FontWeight="SemiBold" Margin="4,0,4,5" />
                                <ListBox x:Name="ReportTargetsList" Grid.Row="1"
                                         Style="{StaticResource ReportTargetsListStyle}"
                                         ItemTemplate="{StaticResource SidebarTargetRowTemplate}"
                                         PreviewMouseRightButtonDown="SelectTargetOnRightClick"
                                         MouseDoubleClick="TargetsList_MouseDoubleClick"
                                         ContextMenuOpening="RequireTargetSelection_ContextMenuOpening">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit target..." Click="EditTargetProject_Click" />
                                            <MenuItem Header="Lower debt..." Click="LowerTargetDebt_Click" />
                                            <MenuItem Header="Cancel debt" Click="CancelTargetDebt_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>
                                <TextBlock Grid.Row="2" Text="No monthly targets set" Margin="4,3,4,2"
                                           Foreground="{StaticResource ContentTertiaryBrush}" FontSize="11" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ReportTargetsList, Path=HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        </StackPanel>
                        </ScrollViewer>
                        <ListBox x:Name="ReportGrid" Grid.Column="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 PreviewMouseRightButtonDown="SelectReportProjectOnRightClick"
                                 SelectionChanged="ReportGrid_SelectionChanged"
                                 MouseDoubleClick="ReportGrid_MouseDoubleClick"
                                 ContextMenuOpening="RequireReportProjectSelection_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit project…" Click="EditReportProject_Click" />
                                    <Separator />
                                    <MenuItem Header="Show" Click="ShowReportProject_Click" />
                                    <Separator />
                                    <MenuItem Header="Set as paid" Click="SetReportProjectPaid_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ReportProjectContainerSurface"
                                                        Background="Transparent"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0,8,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="8,10,8,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project}" Foreground="{StaticResource InkBrush}"
                                                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Ellipse Width="5" Height="5" Margin="9,1,9,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource ProjectClientDotBrush}" />
                                                <TextBlock Text="{Binding Client}" Foreground="{StaticResource ProjectClientTextBrush}"
                                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" Margin="24,0,0,0"
                                                  RowHeight="31" ColumnHeaderHeight="31"
                                                  SelectionMode="Single" SelectionUnit="FullRow"
                                                  Loaded="ReportTaskGrid_Loaded"
                                                  PreviewMouseLeftButtonUp="ReportTaskGrid_PreviewMouseLeftButtonUp"
                                                  PreviewMouseRightButtonDown="SelectRowOnRightClick"
                                                  SelectionChanged="ReportTaskGrid_SelectionChanged"
                                                  MouseDoubleClick="ReportTaskGrid_MouseDoubleClick"
                                                  ContextMenuOpening="ReportTaskGrid_ContextMenuOpening"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <DataGrid.Resources>
                                                <ContextMenu x:Key="ReportColumnHeaderMenu" x:Shared="False"
                                                             DataContext="{Binding PlacementTarget.Column, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Hide column" Click="ReportHideColumn_Click" />
                                                </ContextMenu>
                                            </DataGrid.Resources>
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}"
                                                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="ContextMenu" Value="{StaticResource ReportColumnHeaderMenu}" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit task…" Tag="SavedTaskOnly" Click="EditReportTask_Click" />
                                                    <Separator Tag="SavedTaskOnly" />
                                                    <MenuItem Header="Show" Click="ShowReportTask_Click" />
                                                    <Separator />
                                                    <MenuItem Header="Set as paid" Click="SetReportTaskPaid_Click" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="220" ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                                <DataGridTextColumn Header="Time" Binding="{Binding TotalTime}" Width="82" ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                                <DataGridTextColumn Header="Time + idle" Binding="{Binding TotalWithShortIdle}" Width="96" ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                                <DataGridTextColumn Header="Calls" Binding="{Binding CallTime}" Width="82" ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="112" ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                                <DataGridTextColumn Header="Logs" Binding="{Binding Entries}" Width="72" ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Grid.Row="2" Margin="24,0,0,0"
                                                BorderBrush="{StaticResource StrongBorderBrush}"
                                                BorderThickness="0,2,0,0" Padding="0,8,0,0">
                                            <Grid MinHeight="28" Tag="ReportSummaryFooter"
                                                  Loaded="ReportSummaryGrid_Loaded">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Project total" Margin="8,0"
                                                           Foreground="{StaticResource ContentSecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding TotalTime}" Margin="8,0"
                                                           FontFamily="Consolas" FontWeight="SemiBold"
                                                           Style="{StaticResource DataGridCellTextStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalWithShortIdle}" Margin="8,0"
                                                           FontFamily="Consolas" FontWeight="SemiBold"
                                                           Style="{StaticResource DataGridCellTextStyle}" />
                                                <TextBlock Grid.Column="3" Text="{Binding CallTime}" Margin="8,0"
                                                           FontFamily="Consolas" FontWeight="SemiBold"
                                                           Style="{StaticResource DataGridCellTextStyle}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Value}" Margin="8,0"
                                                           FontWeight="SemiBold" Style="{StaticResource DataGridCellTextStyle}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Entries}" Margin="8,0"
                                                           Style="{StaticResource DataGridCellTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid Width="227">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                        <Button x:Name="UpdateBellButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                Margin="4,-5,-8,-5" Visibility="Collapsed" Click="UpdateBell_Click"
                                ToolTip="A new version of Log O'clock is available. Open Settings to learn more."
                                ToolTipService.InitialShowDelay="1000"
                                AutomationProperties.Name="Open available update details">
                            <Path Data="{StaticResource Icon.Bell}" Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" />
                        </Button>
                    </Grid>
                </TabItem.Header>
                <Grid Margin="32,24" MaxWidth="768" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Configure tracking, idle behavior, targets, integrations, and application preferences"
                                   Style="{StaticResource PageDescriptionTextStyle}" />
                    </StackPanel>
                    <TabControl x:Name="SettingsCategoryTabs" Grid.Row="1" Margin="0,16,0,0"
                                AutomationProperties.Name="Settings categories">
                        <TabItem Header="Tracking">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Margin="4,8,4,24">
                                    <TextBlock Text="Tracking" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Project recognition and automatic continuation rules"
                                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <CheckBox x:Name="RecognitionCheck" Margin="0,24,0,8" Content="Recognize configured projects from active window titles"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="RecognitionCheck_Changed" Unchecked="RecognitionCheck_Changed" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                Text="Window titles are matched in memory and unknown titles are never stored. The app has no telemetry; network access occurs only for Trello or Google Sheets connections configured in this profile." />
                    <TextBlock Text="Full automatic mode grace period"
                               FontWeight="SemiBold" Margin="0,28,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AutomaticRecognitionGraceMinutesText"
                                 Width="88"
                                 HorizontalAlignment="Left"
                                 LostKeyboardFocus="AutomaticRecognitionGraceMinutesText_LostKeyboardFocus"
                                 PreviewKeyDown="AutomaticRecognitionGraceMinutesText_PreviewKeyDown"
                                 ToolTip="Whole minutes from 1 to 1440"
                                 AutomationProperties.Name="Automatic project tracking grace period in minutes" />
                        <TextBlock Text="minutes" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Use the unlabeled toggle beside the profile selector to enable full automatic mode. A stop or project switch becomes final after this delay but is saved at the original foreground-change time."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock x:Name="AutomaticRecognitionGraceValidationText"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Margin="3,5,0,0" Visibility="Collapsed" />
                    <TextBlock Text="Continue a matching recent entry when the gap is shorter than"
                               FontWeight="SemiBold" Margin="0,28,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="RecentEntryResumeMinutesText"
                                 Width="88"
                                 HorizontalAlignment="Left"
                                 LostKeyboardFocus="RecentEntryResumeMinutesText_LostKeyboardFocus"
                                 PreviewKeyDown="RecentEntryResumeMinutesText_PreviewKeyDown"
                                 ToolTip="Whole minutes from 0 to 1440; 0 disables this behavior"
                                 AutomationProperties.Name="Maximum gap for continuing a matching recent entry in minutes" />
                        <TextBlock Text="minutes" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="When the immediately previous unpaid entry has the same project, task, description, and tags, starting again inside this gap reopens that entry and counts the gap as tracked time. Set 0 to always create a new entry."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock x:Name="RecentEntryResumeValidationText"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Margin="3,5,0,0" Visibility="Collapsed" />
                    <TextBlock Text="Break reminders" FontWeight="SemiBold" Margin="0,28,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Show a break reminder every" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                        <TextBox x:Name="BreakReminderMinutesText"
                                 Width="88" Margin="10,0,0,0"
                                 HorizontalAlignment="Left"
                                 LostKeyboardFocus="BreakReminderMinutesText_LostKeyboardFocus"
                                 PreviewKeyDown="BreakReminderMinutesText_PreviewKeyDown"
                                 ToolTip="Whole minutes from 1 to 1440"
                                 AutomationProperties.Name="Break reminder interval in minutes" />
                        <TextBlock Text="minutes" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Counts net tracked time while the timer runs, including project switches and rips. The reminder closes automatically after 3 seconds."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock x:Name="BreakReminderValidationText"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Margin="3,5,0,0" Visibility="Collapsed" />
                    <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <WrapPanel>
                        <RadioButton x:Name="BreakReminderBottomRight" Content="Bottom right" Tag="BottomRight"
                                     GroupName="BreakReminderPlacement" Style="{StaticResource TargetReviewChoiceStyle}"
                                     Checked="BreakReminderPlacement_Changed" />
                        <RadioButton x:Name="BreakReminderScreenCenter" Content="Centre of screen" Tag="ScreenCenter"
                                     GroupName="BreakReminderPlacement" Style="{StaticResource TargetReviewChoiceStyle}"
                                     Checked="BreakReminderPlacement_Changed" />
                    </WrapPanel>
                    <TextBlock Text="Messages" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBlock Text="Choose the messages that can appear. The app chooses randomly among the least-used available messages each day."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,0,0,8" />
                    <StackPanel x:Name="BreakReminderMessagesPanel">
                        <CheckBox x:Name="BreakReminderBathroomMessageCheck" Tag="bathroom"
                                  Content="you really need a bathroom" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderBreakMessageCheck" Tag="break"
                                  Content="breeeak !" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderCoffeeMessageCheck" Tag="coffee"
                                  Content="how about coffee?" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderTeaMessageCheck" Tag="tea"
                                  Content="Make a tea." Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderSnackMessageCheck" Tag="snack"
                                  Content="snack time!" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderStandUpMessageCheck" Tag="stand-up"
                                  Content="Just stand up and do something" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderLaundryMessageCheck" Tag="laundry"
                                  Content="Do this fkn loundry!" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderDinnerMessageCheck" Tag="dinner"
                                  Content="...dinner? (12:00–18:00)" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                        <CheckBox x:Name="BreakReminderEpisodeMessageCheck" Tag="episode"
                                  Content="One episode...but short one! (10:00–22:00)" Margin="0,0,0,6"
                                  Checked="BreakReminderMessage_Changed" Unchecked="BreakReminderMessage_Changed" />
                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Idle &amp; sessions">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Margin="4,8,4,24">
                                    <TextBlock Text="Idle &amp; sessions" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Windows availability, protected activity, and idle review thresholds"
                                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <TextBlock Text="When Windows locks, signs out, or sleeps" FontWeight="SemiBold" Margin="0,28,0,6" />
                    <ComboBox x:Name="SessionBehaviorCombo"
                              SelectionChanged="SessionBehaviorCombo_SelectionChanged"
                              AutomationProperties.Name="Timer behavior when Windows is unavailable">
                        <ComboBoxItem Content="Stop the running timer" />
                        <ComboBoxItem Content="Keep running and review unavailable time" />
                    </ComboBox>
                    <TextBlock x:Name="SessionBehaviorDescriptionText"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock Text="Idle protection" FontWeight="SemiBold" Margin="0,28,0,6" />
                    <CheckBox x:Name="CallsIdleProtectionCheck"
                              Margin="0,0,0,8"
                              Content="Treat calls and sustained foreground audio as activity"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="CallsIdleProtectionCheck_Changed"
                              Unchecked="CallsIdleProtectionCheck_Changed" />
                    <TextBlock Text="Protects listen-only calls through communications-render audio. If an app does not identify a call, its foreground render audio qualifies after 10 continuous seconds; background ordinary audio and explicit music are ignored."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <CheckBox x:Name="VideoIdleProtectionCheck"
                              Margin="0,16,0,8"
                              Content="Treat playing video as activity"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="VideoIdleProtectionCheck_Changed"
                              Unchecked="VideoIdleProtectionCheck_Changed" />
                    <TextBlock Text="Protects playing Windows media sessions reported as video or unclassified media. Sessions explicitly reported as music or images are ignored."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <Border Margin="0,16,0,0" Padding="12,8"
                            Background="{StaticResource StateHoverBrush}"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="IdleProtectionStatusDot" Width="7" Height="7"
                                     Margin="0,0,9,0" VerticalAlignment="Center"
                                     Fill="{StaticResource ContentTertiaryBrush}" />
                            <TextBlock x:Name="IdleProtectionStatusText"
                                       Text="Idle protection is starting…"
                                       Foreground="{StaticResource ContentSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="IdleProtectionPrivacyText"
                               Text="Output-only detection — microphone activity is never accessed. No audio sessions, processes, media metadata, or protection history are stored."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,8,0,0" />
                    <TextBlock Text="Review excluded software after" FontWeight="SemiBold" Margin="0,28,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ExcludedSoftwareReviewMinutesText"
                                 Width="88"
                                 HorizontalAlignment="Left"
                                 LostKeyboardFocus="ExcludedSoftwareReviewMinutesText_LostKeyboardFocus"
                                 PreviewKeyDown="ExcludedSoftwareReviewMinutesText_PreviewKeyDown"
                                 ToolTip="Whole minutes from 1 to 1440"
                                 AutomationProperties.Name="Excluded software review threshold in minutes" />
                        <TextBlock Text="minutes" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Separate visits are summed for each excluded app. After this total is reached, the app asks once per app and applies that decision to later visits during the same running entry."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock x:Name="ExcludedSoftwareReviewValidationText"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Margin="3,5,0,0" Visibility="Collapsed" />
                    <TextBlock Text="Review accumulated short idle time after" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AccumulatedAwayReviewMinutesText"
                                 Width="88"
                                 HorizontalAlignment="Left"
                                 LostKeyboardFocus="AccumulatedAwayReviewMinutesText_LostKeyboardFocus"
                                 PreviewKeyDown="AccumulatedAwayReviewMinutesText_PreviewKeyDown"
                                 ToolTip="Whole minutes from 1 to 1440"
                                 AutomationProperties.Name="Accumulated short idle review threshold in minutes" />
                        <TextBlock Text="minutes" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Only idle intervals shorter than 5 minutes are combined while tracking. They carry across entries, but only time within the previous 4 hours is counted; older time expires automatically. After No, the next reminder is at 3x the threshold and then at every following multiple."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock x:Name="AccumulatedAwayReviewValidationText"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Margin="3,5,0,0" Visibility="Collapsed" />
                    <TextBlock Text="Include short idle in reports and eligible targets up to"
                               FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ShortIdleReportingMinutesText"
                                 Width="88"
                                 HorizontalAlignment="Left"
                                 LostKeyboardFocus="ShortIdleReportingMinutesText_LostKeyboardFocus"
                                 PreviewKeyDown="ShortIdleReportingMinutesText_PreviewKeyDown"
                                 ToolTip="Whole minutes from 1 to 60"
                                 AutomationProperties.Name="Maximum short idle interval included in reports and targets, in minutes" />
                        <TextBlock Text="minutes" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource ContentSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="The Time + idle report metric adds back each excluded idle interval no longer than this limit. Longer idle intervals stay excluded. Targets can choose this metric individually."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock x:Name="ShortIdleReportingValidationText"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Margin="3,5,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Targets">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Margin="4,8,4,24">
                                    <TextBlock Text="Target reminders" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose when Log O'clock summarizes weekly and monthly progress"
                                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <CheckBox x:Name="TargetReviewNotificationCheck" Margin="0,28,0,8"
                              Content="Show scheduled weekly and monthly target review"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="TargetReviewNotificationCheck_Changed"
                              Unchecked="TargetReviewNotificationCheck_Changed" />
                    <TextBlock Text="Shows one compact reminder on the selected weekday and week of the month when any project has a weekly or monthly target, including carried target debt."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <StackPanel x:Name="TargetReviewSchedulePanel" Margin="0,12,0,0">
                        <TextBlock Text="Day of week" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <RadioButton x:Name="TargetReviewMonday" Content="Mon" Tag="Monday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                            <RadioButton x:Name="TargetReviewTuesday" Content="Tue" Tag="Tuesday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                            <RadioButton x:Name="TargetReviewWednesday" Content="Wed" Tag="Wednesday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                            <RadioButton x:Name="TargetReviewThursday" Content="Thu" Tag="Thursday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                            <RadioButton x:Name="TargetReviewFriday" Content="Fri" Tag="Friday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                            <RadioButton x:Name="TargetReviewSaturday" Content="Sat" Tag="Saturday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                            <RadioButton x:Name="TargetReviewSunday" Content="Sun" Tag="Sunday" GroupName="TargetReviewDay"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewDay_Changed" />
                        </WrapPanel>
                        <TextBlock Text="Week in month" FontWeight="SemiBold" Margin="0,8,0,6" />
                        <WrapPanel>
                            <RadioButton x:Name="TargetReviewFirstWeek" Content="First" Tag="First" GroupName="TargetReviewMonthWeek"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewMonthWeek_Changed" />
                            <RadioButton x:Name="TargetReviewSecondWeek" Content="Second" Tag="Second" GroupName="TargetReviewMonthWeek"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewMonthWeek_Changed" />
                            <RadioButton x:Name="TargetReviewPenultimateWeek" Content="Penultimate" Tag="Penultimate" GroupName="TargetReviewMonthWeek"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewMonthWeek_Changed" />
                            <RadioButton x:Name="TargetReviewLastWeek" Content="Last" Tag="Last" GroupName="TargetReviewMonthWeek"
                                         Style="{StaticResource TargetReviewChoiceStyle}" Checked="TargetReviewMonthWeek_Changed" />
                        </WrapPanel>
                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Integrations">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Margin="4,8,4,24">
                                    <TextBlock Text="Integrations" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Profile-specific connections for tasks and exported logs"
                                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <TextBlock Text="Trello" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,4" />
                    <TextBlock Text="Read-only task synchronization for this profile"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <Border Padding="14" Background="{StaticResource SurfaceEditorBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Navigation}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TrelloConnectionText" Text="Not connected" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TrelloSyncStatusText" Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               Text="Connect Trello to import assigned cards." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="TrelloConnectButton" Content="Connect" Click="TrelloConnect_Click" />
                                    <Button x:Name="TrelloSyncButton" Content="Sync now" Click="TrelloSync_Click" IsEnabled="False" />
                                    <Button x:Name="TrelloDisconnectButton" Content="Disconnect" Click="TrelloDisconnect_Click" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="TrelloMappingsGrid" Height="190" Margin="0,14,0,0"
                                      PreviewMouseRightButtonDown="SelectRowOnRightClick"
                                      MouseDoubleClick="TrelloMappingsGrid_MouseDoubleClick"
                                      ContextMenuOpening="TrelloMappingsGrid_ContextMenuOpening"
                                      SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add mapping…" Tag="EmptyOnly" Click="AddTrelloMapping_Click" />
                                        <MenuItem Header="Edit…" Tag="TrelloMappingOnly" Click="EditTrelloMapping_Click" />
                                        <Separator Tag="TrelloMappingOnly" />
                                        <MenuItem Header="Remove" Tag="TrelloMappingOnly" Click="RemoveTrelloMapping_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Board" Binding="{Binding Board}" Width="170"
                                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                    <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="150"
                                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                    <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="130"
                                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                    <DataGridTextColumn Header="Lists" Binding="{Binding Lists}" Width="260"
                                                        ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="2,10,2,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Only open cards assigned to the connected account in selected lists are read. Tokens are kept in Windows Credential Manager; card descriptions, labels, comments, and activity history are not stored." />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Google Sheets" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,4" />
                    <TextBlock Text="Shared whole-profile synchronization and readable daily logs"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <Border Padding="14" Background="{StaticResource SurfaceEditorBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Navigation}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="GoogleSheetsConnectionText" Text="Not connected" FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoogleSheetsSyncStatusText" Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               Text="Daily CSV exports are stored locally." />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Button x:Name="GoogleSheetsConnectButton" Content="Connect" Click="GoogleSheetsConnect_Click" />
                                    <Button x:Name="GoogleSheetsSyncButton" Content="Sync now" Click="GoogleSheetsSync_Click" IsEnabled="False" />
                                    <Button x:Name="GoogleSheetsOpenButton" Content="Open spreadsheet" Click="GoogleSheetsOpen_Click" IsEnabled="False" />
                                    <Button x:Name="GoogleSheetsDisconnectButton" Content="Disconnect" Click="GoogleSheetsDisconnect_Click" IsEnabled="False" />
                                </WrapPanel>
                            </Grid>
                            <CheckBox x:Name="GoogleSheetsCloudExportCheck" Margin="0,14,0,4"
                                      Content="Synchronize this profile through Google Sheets"
                                      Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False"
                                      Checked="GoogleSheetsCloudExportCheck_Changed"
                                      Unchecked="GoogleSheetsCloudExportCheck_Changed" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="This computer" FontWeight="SemiBold" Margin="2,0,0,4" />
                                    <DockPanel LastChildFill="True">
                                        <Button Content="Save" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                Click="GoogleSheetsSaveDeviceName_Click" />
                                        <TextBox x:Name="GoogleSheetsDeviceNameText"
                                                 AutomationProperties.Name="Synchronization device name" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Daily worksheet time zone" FontWeight="SemiBold" Margin="2,0,0,4" />
                                    <DockPanel LastChildFill="True">
                                        <Button Content="Apply" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                Click="GoogleSheetsApplyTimeZone_Click" />
                                        <ComboBox x:Name="GoogleSheetsTimeZoneCombo" DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id" AutomationProperties.Name="Daily worksheet time zone" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GoogleSheetsConflictStatusText" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" Text="No conflicts need review." />
                                <Button x:Name="GoogleSheetsReviewConflictsButton" Grid.Column="1"
                                        Content="Review conflicts" Click="GoogleSheetsReviewConflicts_Click"
                                        IsEnabled="False" />
                            </Grid>
                            <TextBlock Margin="2,7,2,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="SQLite remains the local working database, so tracking continues offline. Completed logs, profile configuration, and durable deletions reconcile in the background; concurrent edits wait for review. Daily tabs are app-managed views grouped in the pinned time zone, and manual edits there are overwritten. Credentials, local running timers, and observed unknown window or media data never enter the shared journal." />
                        </StackPanel>
                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Application">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Margin="4,8,4,24">
                                    <TextBlock Text="Application" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Startup, local storage, tray behavior, and product information"
                                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <CheckBox x:Name="AutostartCheck" Margin="0,24,0,8" Content="Launch Log O'clock when I sign in"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed" />
                    <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <TextBlock Text="Keep Log O'clock informed about published GitHub releases"
                               Style="{StaticResource PageDescriptionTextStyle}" />
                    <CheckBox x:Name="UpdateChecksEnabledCheck" Margin="0,18,0,8"
                              Content="Check GitHub for new versions automatically"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="UpdateChecksEnabledCheck_Changed"
                              Unchecked="UpdateChecksEnabledCheck_Changed" />
                    <TextBlock Text="A check contacts GitHub's public release service and shares your IP address with GitHub. No tracking data or profile information is sent."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <Border Margin="0,14,0,0" Padding="12" Background="{StaticResource StateHoverBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Navigation}">
                        <StackPanel>
                            <TextBlock x:Name="UpdateInstalledVersionText" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateStatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource ContentSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="CheckForUpdatesButton" Content="Check for updates"
                                        Click="CheckForUpdates_Click" />
                                <Button x:Name="OpenUpdateReleaseButton" Content="Open release page" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="OpenUpdateRelease_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Storage folder" FontWeight="SemiBold" Margin="0,28,0,5" />
                    <TextBox x:Name="DatabasePathText" IsReadOnly="True" />
                    <TextBlock Text="Active data is kept in TimeTracker.db. Safety snapshots are saved under Daily Backups. Local mode writes one CSV per day under Daily Logs and retains older revisions; Google Sheets mode sends those daily log exports to one worksheet per day. Existing monthly CSV files remain compatible."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0" />
                    <TextBlock Text="Closing the main window keeps the tracker running in the system tray. Use Exit from the tray menu to stop it completely."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,0" />
                    <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,4" />
                    <TextBlock x:Name="AboutProductText" Text="Log O'clock" FontWeight="SemiBold" />
                    <TextBlock x:Name="AboutAuthorText" Text="Created by Zachariasz Jędrzejczyk"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,24" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Border x:Name="SidebarTargetsPanel" Grid.Row="2" Width="275" Height="312" MinHeight="96"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="2"
                Background="{StaticResource SurfaceSidebarBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,1,0" Padding="12,0,12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Thumb x:Name="SidebarTargetsResizeThumb"
                       Grid.Row="0"
                       Margin="-12,0,-12,0"
                       Style="{StaticResource SidebarTargetsResizeThumbStyle}"
                       DragStarted="SidebarTargetsResizeThumb_DragStarted"
                       DragDelta="SidebarTargetsResizeThumb_DragDelta"
                       DragCompleted="SidebarTargetsResizeThumb_DragCompleted"
                       ToolTip="Drag to resize targets"
                       AutomationProperties.Name="Resize sidebar targets panel" />
                <Grid Grid.Row="1" Margin="4,0,4,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TARGETS" Foreground="{StaticResource ContentTertiaryBrush}"
                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="D / W / M / 1×" Foreground="{StaticResource ContentTertiaryBrush}"
                               FontSize="9" VerticalAlignment="Center" />
                </Grid>
                <ListBox x:Name="TargetsGrid" Grid.Row="2" MinHeight="0" Tag="SidebarTargetRing"
                         Style="{StaticResource SidebarTargetsListStyle}"
                         ItemTemplate="{StaticResource SidebarTargetRowTemplate}"
                         PreviewMouseRightButtonDown="SelectTargetOnRightClick"
                         MouseDoubleClick="TargetsList_MouseDoubleClick"
                         ContextMenuOpening="RequireTargetSelection_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit target..." Click="EditTargetProject_Click" />
                            <MenuItem Header="Lower debt..." Click="LowerTargetDebt_Click" />
                            <MenuItem Header="Cancel debt" Click="CancelTargetDebt_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock Grid.Row="3" Text="No targets set" Margin="4,3,4,2"
                           Foreground="{StaticResource ContentTertiaryBrush}" FontSize="11" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TargetsGrid, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
