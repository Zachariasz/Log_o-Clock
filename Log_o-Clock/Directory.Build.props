<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>1.144.2</Version>
    <AssemblyVersion>1.144.2.0</AssemblyVersion>
    <FileVersion>1.144.2.0</FileVersion>
    <Product>Log O'clock</Product>
    <Title>Log O'clock</Title>
    <AssemblyTitle>Log O'clock</AssemblyTitle>
    <Authors>Zachariasz Jędrzejczyk</Authors>
    <Company>Zachariasz Jędrzejczyk</Company>
    <Copyright>Copyright © 2026 Zachariasz Jędrzejczyk</Copyright>
    <Description>Time tracking by client, project, and task.</Description>
  </PropertyGroup>
</Project>
